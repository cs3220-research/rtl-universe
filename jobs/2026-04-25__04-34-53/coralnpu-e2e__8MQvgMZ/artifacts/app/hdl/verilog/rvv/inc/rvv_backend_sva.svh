//
// SVA assertion macros for the RVV backend. Stubbed empty so the design can
// compile under tools that may not support SystemVerilog assertions.

`ifndef RVV_BACKEND_SVA_SVH
`define RVV_BACKEND_SVA_SVH

`define RVV_ASSERT(name, expr)
`define RVV_ASSUME(name, expr)
`define RVV_COVER(name, expr)

`endif  // RVV_BACKEND_SVA_SVH
